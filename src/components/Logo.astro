---
interface Props { size?: 'md' | 'lg'; inverse?: boolean }
const { size = 'md', inverse = false } = Astro.props;
---
<span class:list={['logo', `logo--${size}`, { 'logo--inverse': inverse }]}>
  <span class="logo__mark" aria-hidden="true">H</span>
  <span class="logo__word">Heuristics</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: stretch;
    gap: 10px;
    color: var(--navy);
    line-height: 1;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: var(--navy);
    color: #fff;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 26px;
    box-shadow: inset 0 -4px 0 var(--orange);
    padding-bottom: 3px;
  }
  .logo__word {
    align-self: center;
    font-family: var(--serif);
    font-weight: 650;
    font-size: 25px;
    letter-spacing: -0.01em;
  }
  .logo--lg .logo__mark { width: 52px; height: 52px; font-size: 36px; }
  .logo--lg .logo__word { font-size: 34px; }
  .logo--inverse { color: #fff; }
  .logo--inverse .logo__mark { background: #fff; color: var(--navy); }
</style>
