---
/**
 * Vertical timeline.
 * <Timeline items={[{ when: '1999', title: 'Term coined', text: 'Morin and Kern use "polycrisis".' }]} />
 */
interface Item { when: string; title: string; text?: string }
interface Props { items: Item[]; title?: string }
const { items, title } = Astro.props;
---
<figure class="tl">
  {title && <figcaption>{title}</figcaption>}
  <ol>
    {items.map((it) => (
      <li>
        <span class="when">{it.when}</span>
        <div>
          <p class="t">{it.title}</p>
          {it.text && <p class="x" set:html={it.text} />}
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  .tl { margin: 2rem 0; font-family: var(--sans); }
  figcaption { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); margin-bottom: 10px; }
  ol { list-style: none; margin: 0; padding: 0; position: relative; }
  ol::before { content: ''; position: absolute; left: 111px; top: 8px; bottom: 8px; width: 2px; background: var(--rule); }
  li { display: grid; grid-template-columns: 100px 1fr; gap: 28px; padding: 10px 0; position: relative; }
  li::before { content: ''; position: absolute; left: 105px; top: 17px; width: 12px; height: 12px; background: var(--paper); border: 3px solid var(--orange); border-radius: 50%; }
  .when { text-align: right; font-weight: 800; font-size: 0.9375rem; color: var(--navy); font-variant-numeric: tabular-nums; padding-top: 3px; }
  .t { margin: 0; font-family: var(--serif); font-weight: 650; font-size: 1.125rem; line-height: 1.3; color: var(--ink); }
  .x { margin: 4px 0 0; font-size: 0.9375rem; line-height: 1.5; color: var(--grey); }
  @media (max-width: 560px) {
    ol::before { left: 5px; }
    li { grid-template-columns: 1fr; gap: 2px; padding-left: 26px; }
    li::before { left: 0; top: 14px; }
    .when { text-align: left; }
  }
</style>
