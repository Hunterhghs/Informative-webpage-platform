---
/** Editorial frame shared by every chart and figure: tag, title, subtitle, source. */
interface Props {
  title?: string;
  subtitle?: string;
  source?: string;
  note?: string;
  wide?: boolean;
  label?: string;
}
const { title, subtitle, source, note, wide = false, label } = Astro.props;
---
<figure class:list={['chart', { 'chart--wide': wide }]}>
  {(title || subtitle) && (
    <figcaption class="chart__head">
      {label && <span class="chart__label">{label}</span>}
      {title && <span class="chart__title">{title}</span>}
      {subtitle && <span class="chart__subtitle">{subtitle}</span>}
    </figcaption>
  )}
  <div class="chart__body"><slot /></div>
  {(source || note) && (
    <p class="chart__source">
      {note && <span>{note} </span>}
      {source && <span>Source: {source}</span>}
    </p>
  )}
</figure>

<style>
  .chart {
    margin: 2.25rem 0;
    padding-top: 14px;
    border-top: 1px solid var(--navy);
    position: relative;
    font-family: var(--sans);
  }
  .chart::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 40px;
    height: 6px;
    background: var(--orange);
  }
  .chart__head { display: grid; gap: 3px; margin-bottom: 16px; }
  .chart__label { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange-ink); }
  .chart__title { font-size: 1.0625rem; font-weight: 700; color: var(--ink); line-height: 1.3; }
  .chart__subtitle { font-size: 0.875rem; color: var(--grey); line-height: 1.4; }
  .chart__source { margin: 12px 0 0; font-size: 0.75rem; color: var(--mgrey); line-height: 1.45; }
  @media (min-width: 960px) {
    .chart--wide { margin-left: calc((var(--measure) - var(--wide)) / 2); margin-right: calc((var(--measure) - var(--wide)) / 2); }
  }
</style>
