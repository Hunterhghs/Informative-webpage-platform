---
interface Props { cite?: string }
const { cite } = Astro.props;
---
<blockquote class="pq">
  <div class="pq__text"><slot /></div>
  {cite && <footer>— {cite}</footer>}
</blockquote>

<style>
  .pq { margin: 2.5rem 0; padding: 18px 0 16px; border-top: 3px solid var(--orange); border-bottom: 1px solid var(--rule); }
  .pq__text { font-family: var(--serif); font-size: clamp(1.375rem, 3vw, 1.75rem); line-height: 1.28; font-weight: 600; color: var(--navy); letter-spacing: -0.01em; }
  .pq__text :global(p) { margin: 0; }
  footer { margin-top: 10px; font-family: var(--sans); font-size: 0.8125rem; color: var(--mgrey); }
</style>
