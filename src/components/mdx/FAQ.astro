---
/**
 * Expandable questions and answers. Answers may include basic HTML.
 * <FAQ items={[{ q: 'Is it new?', a: 'No. The term dates to the 1990s.' }]} />
 */
interface Item { q: string; a: string }
interface Props { items: Item[]; title?: string; open?: boolean }
const { items, title, open = false } = Astro.props;
---
<div class="faq">
  {title && <p class="faq__title">{title}</p>}
  {items.map((it, i) => (
    <details open={open && i === 0}>
      <summary>{it.q}</summary>
      <div class="a" set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq { margin: 2rem 0; border-top: 3px solid var(--navy); font-family: var(--sans); }
  .faq__title { margin: 12px 0 4px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); }
  details { border-bottom: 1px solid var(--rule); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 14px 2px; font-family: var(--serif); font-size: 1.125rem; font-weight: 650; line-height: 1.3; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex-shrink: 0; font: 400 1.5rem/1 var(--sans); color: var(--orange-ink); }
  details[open] summary::after { content: '−'; }
  summary:hover { color: var(--blue); }
  .a { padding: 0 2px 16px; font-size: 1rem; line-height: 1.6; color: var(--grey); max-width: 70ch; }
  .a :global(p) { margin: 0 0 0.7em; }
</style>
