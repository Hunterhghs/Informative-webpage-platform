---
/**
 * Grid of short cards — good for lists of mechanisms, options, principles or steps.
 * <Cards cols={3} items={[{ label: '01', title: 'Common causes', text: 'One stress feeds several crises.' }]} />
 * `text` may include basic HTML (<strong>, <em>, <a>). Optional `href` makes the whole title a link.
 */
interface Item { label?: string; title: string; text?: string; href?: string; tag?: string }
interface Props { items: Item[]; cols?: 2 | 3 | 4; tone?: 'plain' | 'tint' }
const { items, cols = 3, tone = 'plain' } = Astro.props;
---
<div class:list={['cards', `cards--${cols}`, `cards--${tone}`]}>
  {items.map((it) => (
    <div class="card">
      {(it.label || it.tag) && (
        <p class="card__top">
          {it.label && <span class="card__label">{it.label}</span>}
          {it.tag && <span class="card__tag">{it.tag}</span>}
        </p>
      )}
      <h3 class="card__title">{it.href ? <a href={it.href}>{it.title}</a> : it.title}</h3>
      {it.text && <p class="card__text" set:html={it.text} />}
    </div>
  ))}
</div>

<style>
  .cards { display: grid; gap: 16px; margin: 2rem 0; font-family: var(--sans); }
  .cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cards--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card { border-top: 3px solid var(--navy); padding: 14px 2px 6px; }
  .cards--tint .card { background: var(--sand); padding: 16px 18px 12px; }
  .card__top { display: flex; justify-content: space-between; gap: 8px; margin: 0 0 6px; }
  .card__label { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; color: var(--orange-ink); }
  .card__tag { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mgrey); }
  .card__title { margin: 0 0 6px; font-family: var(--serif); font-size: 1.1875rem; font-weight: 650; line-height: 1.25; color: var(--ink); }
  .card__title a { color: inherit; text-decoration: none; }
  .card__title a:hover { color: var(--blue); }
  .card__text { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--grey); }
  @media (max-width: 860px) { .cards--3, .cards--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cards--2, .cards--3, .cards--4 { grid-template-columns: 1fr; } }
</style>
