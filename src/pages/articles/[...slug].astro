---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import KeyStats from '../../components/mdx/KeyStats.astro';
import { mdxComponents } from '../../components/mdx';
import { getArticles, formatDate, issueNo, type Article } from '../../lib/articles';
import { SITE, topicById } from '../../site.config';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, i) => ({
    params: { slug: article.id },
    props: {
      article,
      newer: articles[i - 1] ?? null,
      older: articles[i + 1] ?? null,
      related: articles
        .filter((a) => a.id !== article.id && a.data.topic === article.data.topic)
        .slice(0, 3),
      fallback: articles.filter((a) => a.id !== article.id).slice(0, 3),
    },
  }));
}

interface Props {
  article: Article;
  newer: Article | null;
  older: Article | null;
  related: Article[];
  fallback: Article[];
}

const { article, newer, older, related, fallback } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const topic = topicById(data.topic)!;
const isGuide = data.format === 'guide';
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const more = related.length ? related : fallback;
const url = new URL(article.url, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.dek,
  datePublished: data.date.toISOString(),
  dateModified: (data.updated ?? data.date).toISOString(),
  author: { '@type': 'Person', name: data.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  articleSection: topic.name,
  keywords: data.tags.join(', '),
  mainEntityOfPage: url,
};
---
<Base title={data.title} description={data.dek} type="article" publishedTime={data.date} modifiedTime={data.updated} jsonLd={jsonLd}>
  <div class="progress" aria-hidden="true"><span id="progress"></span></div>

  <article class:list={['article', { 'article--guide': isGuide }]} data-pagefind-body>
    <header class="container article__head">
      <div class="col">
        <p class="article__flytitle" data-pagefind-ignore>
          <a class="kicker" href={`/topics/${topic.id}/`} data-pagefind-filter="topic">{topic.name}</a>
          {isGuide && <><span class="flysep" aria-hidden="true">|</span><span class="kicker kicker--plain">Guide</span></>}
          {data.kicker && <><span class="flysep" aria-hidden="true">|</span><span class="kicker kicker--plain">{data.kicker}</span></>}
          <span class="issue" data-pagefind-ignore>{issueNo(article.number)}</span>
        </p>
        <span class="visually-hidden" data-pagefind-filter="format">{isGuide ? 'Guide' : 'Article'}</span>
        <h1 class="headline article__title" data-pagefind-meta="title">{data.title}</h1>
        <p class="dek article__dek">{data.dek}</p>
        <p class="meta article__byline" data-pagefind-ignore>
          <span>By <strong>{data.author}</strong></span>
          <span class="sep">|</span>
          <time datetime={data.date.toISOString()} data-pagefind-meta="date">{formatDate(data.date)}</time>
          <span class="sep">|</span>
          <span>{isGuide ? 'Quick reference' : `${article.readingMinutes} min read`}</span>
          {data.updated && <><span class="sep">|</span><span>Updated {formatDate(data.updated, 'short')}</span></>}
          <button class="share" type="button" data-url={url} aria-label="Copy link to this article">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1 1"/><path d="M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1-1"/></svg>
            <span>Copy link</span>
          </button>
        </p>
        {isGuide && toc.length > 1 && (
          <nav class="jump" aria-label="Jump to section" data-pagefind-ignore>
            <span class="jump__label">Jump to</span>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}
      </div>
    </header>

    <div class="container article__grid">
      {!isGuide && toc.length > 2 && (
        <nav class="toc" aria-label="Contents" data-pagefind-ignore>
          <div class="toc__inner">
            <p class="toc__label">Contents</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </div>
        </nav>
      )}

      <div class="col">
        {data.stats.length > 0 && <KeyStats items={data.stats} />}
        {data.takeaways.length > 0 && (
          <section class="brief" aria-labelledby="brief-h">
            <h2 id="brief-h">In brief</h2>
            <ol>{data.takeaways.map((t) => <li><span set:html={t} /></li>)}</ol>
          </section>
        )}

        <div class:list={['prose', { 'prose--guide': isGuide }]}>
          <Content components={mdxComponents} />
        </div>

        {data.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-h">
            <h2 id="sources-h">Sources</h2>
            <ol>
              {data.sources.map((s) => (
                <li>
                  {s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}
                  {s.publisher && <>. {s.publisher}</>}
                  {s.year && <> ({s.year})</>}
                </li>
              ))}
            </ol>
          </section>
        )}

        <footer class="article__foot" data-pagefind-ignore>
          {data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">{data.tags.map((t) => <li><span>{t}</span></li>)}</ul>
          )}
          <div class="author">
            <span class="author__mark" aria-hidden="true">H</span>
            <div>
              <p class="author__name">{data.author}</p>
              <p class="author__role">{data.author === SITE.author ? SITE.authorRole : SITE.name}</p>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </article>

  <div class="container" data-pagefind-ignore>
    {(newer || older) && (
      <nav class="pager" aria-label="More articles">
        {older ? <a class="pager__link" href={older.url}><span class="meta">← Previous · {issueNo(older.number)}</span><span class="pager__title">{older.data.title}</span></a> : <span></span>}
        {newer ? <a class="pager__link pager__link--next" href={newer.url}><span class="meta">Next · {issueNo(newer.number)} →</span><span class="pager__title">{newer.data.title}</span></a> : <span></span>}
      </nav>
    )}

    {more.length > 0 && (
      <section class="more">
        <div class="section-head">
          <h2>{related.length ? `More on ${topic.name}` : 'Latest'}</h2>
          <a href={related.length ? `/topics/${topic.id}/` : '/archive/'}>See all →</a>
        </div>
        <div class="more__grid">{more.map((a) => <ArticleCard article={a} size="sm" />)}</div>
      </section>
    )}
  </div>
</Base>

<script>
  const bar = document.getElementById('progress');
  const body = document.querySelector('.article') as HTMLElement | null;
  if (bar && body) {
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    document.addEventListener('scroll', update, { passive: true });
    update();
  }
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (tocLinks.length && 'IntersectionObserver' in window) {
    const byId = new Map(tocLinks.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          tocLinks.forEach((a) => a.classList.remove('is-active'));
          byId.get(e.target.id)?.classList.add('is-active');
        });
      },
      { rootMargin: '-90px 0px -70% 0px' },
    );
    byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  }
  document.querySelectorAll<HTMLButtonElement>('.share').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => (label.textContent = 'Copy link'), 1800);
    });
  });
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--orange); transform-origin: 0 50%; transform: scaleX(0); }

  .article--guide { --measure: 880px; }
  .col { max-width: var(--measure); margin: 0 auto; width: 100%; }
  .article__head { padding-top: 44px; padding-bottom: 28px; }
  .article__flytitle { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin: 0 0 14px; }
  .flysep { color: var(--lgrey); font-family: var(--sans); font-size: 0.75rem; }
  .kicker--plain { color: var(--grey); }
  .article__flytitle .issue { margin-left: auto; }
  .article__title { font-size: clamp(2.125rem, 5.4vw, 3.5rem); line-height: 1.04; letter-spacing: -0.02em; }
  .article__dek { margin-top: 16px; font-size: clamp(1.1875rem, 2.4vw, 1.4375rem); line-height: 1.4; }
  .article__byline { display: flex; flex-wrap: wrap; align-items: center; row-gap: 6px; margin: 24px 0 0; padding-top: 14px; border-top: 1px solid var(--rule); }
  .article__byline strong { color: var(--ink); font-weight: 600; }
  .share {
    margin-left: auto; display: inline-flex; align-items: center; gap: 6px;
    font: 600 0.75rem var(--sans); color: var(--navy); background: none;
    border: 1px solid var(--rule); padding: 5px 9px; cursor: pointer;
  }
  .share:hover { border-color: var(--navy); }

  .jump { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 14px; margin-top: 18px; padding: 12px 0; border-top: 1px solid var(--rule); border-bottom: 3px solid var(--navy); font-family: var(--sans); }
  .jump__label { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange-ink); }
  .jump ul { display: flex; flex-wrap: wrap; gap: 6px 4px; list-style: none; margin: 0; padding: 0; }
  .jump a { display: block; font-size: 0.8125rem; font-weight: 600; color: var(--navy); text-decoration: none; padding: 4px 10px; border: 1px solid var(--rule); }
  .jump a:hover { border-color: var(--navy); background: var(--sand); }
  .article__grid { position: relative; }
  .toc { display: none; }
  @media (min-width: 1180px) {
    .toc {
      display: block; position: absolute; left: var(--gutter); top: 0; bottom: 0;
      width: calc((100% - var(--measure)) / 2 - var(--gutter) - 40px); max-width: 230px;
    }
    .toc__inner { position: sticky; top: 100px; }
    .toc__label { margin: 0 0 10px; }
  }
  .toc__label { font: 700 0.6875rem var(--sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); border-top: 3px solid var(--navy); padding-top: 8px; }
  .toc ol { list-style: none; padding: 0; margin: 0; counter-reset: toc; }
  .toc li { counter-increment: toc; border-top: 1px solid var(--rule-soft); }
  .toc a {
    display: grid; grid-template-columns: 22px 1fr; padding: 8px 0;
    font: 500 0.8125rem/1.35 var(--sans); color: var(--grey); text-decoration: none;
  }
  .toc a::before { content: counter(toc); color: var(--orange-ink); font-weight: 700; }
  .toc a:hover, .toc a.is-active { color: var(--navy); }

  .brief { background: var(--sand); border-top: 3px solid var(--navy); padding: 18px 22px 8px; margin: 0 0 2.25rem; font-family: var(--sans); }
  .brief h2 { margin: 0 0 10px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); }
  .brief ol { list-style: none; margin: 0; padding: 0; counter-reset: brief; }
  .brief li { counter-increment: brief; display: grid; grid-template-columns: 26px 1fr; padding: 0 0 12px; font-size: 0.96875rem; line-height: 1.5; }
  .brief li::before { content: counter(brief); font-weight: 800; color: var(--orange-ink); }

  .sources { margin-top: 2.5rem; padding-top: 14px; border-top: 1px solid var(--navy); font-family: var(--sans); }
  .sources h2 { margin: 0 0 10px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); }
  .sources ol { margin: 0; padding-left: 1.4em; font-size: 0.8125rem; line-height: 1.5; color: var(--grey); display: grid; gap: 5px; }

  .article__foot { margin-top: 2.25rem; display: grid; gap: 22px; }
  .author { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); font-family: var(--sans); }
  .author__mark { display: grid; place-items: center; width: 44px; height: 44px; background: var(--navy); color: #fff; font: 700 24px var(--serif); box-shadow: inset 0 -4px 0 var(--orange); }
  .author p { margin: 0; }
  .author__name { font-weight: 700; font-size: 0.9375rem; }
  .author__role { font-size: 0.8125rem; color: var(--mgrey); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 56px 0 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .pager__link { display: grid; gap: 6px; padding: 18px 0; text-decoration: none; }
  .pager__link--next { text-align: right; }
  .pager__title { font: 650 1.0625rem/1.3 var(--serif); color: var(--ink); }
  .pager__link:hover .pager__title { color: var(--blue); }

  .more { margin-top: 56px; }
  .more__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  @media (max-width: 760px) {
    .more__grid { grid-template-columns: 1fr; gap: 22px; }
    .pager { grid-template-columns: 1fr; gap: 0; }
    .pager__link--next { text-align: left; border-top: 1px solid var(--rule); }
    .share span { display: none; }
  }
</style>
