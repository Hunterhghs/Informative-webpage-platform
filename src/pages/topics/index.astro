---
import Base from '../../layouts/Base.astro';
import { getArticles, issueNo } from '../../lib/articles';
import { TOPICS } from '../../site.config';

const articles = await getArticles();
const topics = TOPICS.map((t) => ({ ...t, items: articles.filter((a) => a.data.topic === t.id) }));
---
<Base title="Topics" description="Browse H Heuristics explainers by topic.">
  <div class="container">
    <header class="page-intro">
      <span class="kicker">Topics</span>
      <h1>Browse by topic</h1>
      <p>Our explainers are organised into {TOPICS.length} sections. Each one builds a connected body of work you can read in any order.</p>
    </header>
    <div class="grid">
      {topics.map((t, i) => (
        <section class="topic">
          <p class="topic__no">{String(i + 1).padStart(2, '0')}</p>
          <h2><a href={`/topics/${t.id}/`}>{t.name}</a></h2>
          <p class="topic__blurb">{t.blurb}</p>
          <p class="meta">{t.items.length} {t.items.length === 1 ? 'explainer' : 'explainers'}</p>
          {t.items.length > 0 && (
            <ul>{t.items.slice(0, 4).map((a) => <li><span class="issue">{issueNo(a.number)}</span><a href={a.url}>{a.data.title}</a></li>)}</ul>
          )}
          <a class="more" href={`/topics/${t.id}/`}>View {t.name} →</a>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 40px 40px; }
  .topic { border-top: 3px solid var(--navy); padding-top: 14px; display: grid; align-content: start; gap: 8px; }
  .topic__no { margin: 0; font: 700 0.75rem var(--sans); color: var(--orange-ink); letter-spacing: 0.1em; }
  h2 { margin: 0; font: 650 1.625rem/1.15 var(--serif); letter-spacing: -0.01em; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--blue); }
  .topic__blurb { margin: 0; color: var(--grey); font-size: 1rem; line-height: 1.45; }
  .meta { margin: 0; }
  ul { list-style: none; margin: 6px 0 0; padding: 0; }
  li { display: grid; grid-template-columns: 58px 1fr; gap: 6px; padding: 9px 0; border-top: 1px solid var(--rule); }
  li .issue { color: var(--mgrey); padding-top: 3px; }
  li a { color: var(--ink); text-decoration: none; font-size: 0.96875rem; line-height: 1.3; font-weight: 550; }
  li a:hover { color: var(--blue); }
  .more { font: 600 0.8125rem var(--sans); text-decoration: none; margin-top: 4px; }
</style>
